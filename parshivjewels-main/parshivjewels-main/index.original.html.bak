      <p class="mt-0.5 flex items-center justify-center gap-2 text-[9px] tracking-[0.6em] text-gold"><span class="h-px w-6 bg-gold/50"></span>JEWELS<span class="h-px w-6 bg-gold/50"></span></p>
    </a>
    <div class="flex items-center justify-end">
      <button id="cartBtn" class="relative flex h-11 w-11 items-center justify-center rounded-full border border-gold/40 text-gold transition hover:bg-gold hover:text-night" aria-label="Open cart">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        <span id="cartCount" class="absolute -right-1 -top-1 hidden h-5 min-w-[20px] items-center justify-center rounded-full bg-gold px-1 text-[11px] font-bold text-night">0</span>
