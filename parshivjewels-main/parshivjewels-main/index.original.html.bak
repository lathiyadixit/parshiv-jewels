<div class="marquee overflow-hidden border-b border-gold/15 bg-onyx py-2">
  <div class="marquee-track text-[11px] uppercase tracking-[0.3em] text-sand/90">
    <div class="flex shrink-0"><span class="px-6">◆ Complimentary Insured Shipping</span><span class="px-6">◆ BIS Hallmarked</span><span class="px-6">◆ 30-Day Returns</span><span class="px-6">◆ Certified Stones</span><span class="px-6">◆ WhatsApp +91 63519 16996</span></div>
    <div class="flex shrink-0" aria-hidden="true"><span class="px-6">◆ Complimentary Insured Shipping</span><span class="px-6">◆ BIS Hallmarked</span><span class="px-6">◆ 30-Day Returns</span><span class="px-6">◆ Certified Stones</span><span class="px-6">◆ WhatsApp +91 63519 16996</span></div>
  </div>
</div>

