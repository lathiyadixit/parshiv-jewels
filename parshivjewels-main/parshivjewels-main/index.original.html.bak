<div id="cartOverlay" class="pointer-events-none fixed inset-0 z-[105] bg-black/70 opacity-0 backdrop-blur-sm transition duration-300"></div>
<aside id="cartDrawer" class="fixed right-0 top-0 z-[110] flex h-full w-full max-w-md translate-x-full flex-col border-l border-gold/25 bg-onyx shadow-soft transition-transform duration-300 ease-out" aria-label="Shopping cart">
  <div class="flex items-center justify-between border-b border-gold/15 px-6 py-5">
    <h2 class="font-display text-2xl font-semibold text-ivory">Your Cart <span id="cartHeaderCount" class="text-gold">(0)</span></h2>
    <button id="cartClose" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-ivory transition hover:border-gold hover:text-gold" aria-label="Close cart">✕</button>
  </div>
  <div id="cartItems" class="flex-1 overflow-y-auto px-6 py-5"></div>
  <div id="cartFooter" class="border-t border-gold/15 px-6 py-6">
    <h3 class="font-display text-xl font-semibold text-ivory">Order Summary</h3>
    <div class="mt-4 space-y-2.5 text-[15px]">
      <div class="flex justify-between"><span>Subtotal</span><span id="sumSub" class="text-ivory">₹0</span></div>
      <div class="flex justify-between"><span>Shipping</span><span class="font-medium text-green-400">Free</span></div>
      <div class="flex justify-between"><span>Tax (18%)</span><span id="sumTax" class="text-ivory">₹0</span></div>
      <div class="flex justify-between border-t border-gold/20 pt-3 text-base font-semibold text-ivory"><span>Total</span><span id="sumTotal" class="text-gold">₹0</span></div>
    </div>
    <button id="waOrderBtn" class="btn-gold mt-5 w-full py-4">Order via WhatsApp</button>
    <button id="continueShopping" class="btn-line mt-3 w-full py-3.5">Continue Shopping</button>
    <p class="mt-4 flex items-center justify-center gap-2 text-[11px] uppercase tracking-[0.2em] text-sand/80"><svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>100% Secure Checkout</p>
  </div>
</aside>

<div id="modal" class="fixed inset-0 z-[115] hidden items-center justify-center p-4" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/75 backdrop-blur-sm" data-close></div>
  <div class="relative grid w-full max-w-3xl overflow-hidden rounded-2xl border border-gold/30 bg-onyx shadow-glow md:grid-cols-2" style="animation:menuIn .3s ease both">
    <span class="pointer-events-none absolute left-3 top-3 z-10 h-4 w-4 border-l border-t border-gold/70"></span>
    <span class="pointer-events-none absolute right-3 top-3 z-10 h-4 w-4 border-r border-t border-gold/70"></span>
    <span class="pointer-events-none absolute bottom-3 left-3 z-10 h-4 w-4 border-b border-l border-gold/70"></span>
    <span class="pointer-events-none absolute bottom-3 right-3 z-10 h-4 w-4 border-b border-r border-gold/70"></span>
    <div class="relative h-60 bg-night sm:h-72 md:h-[460px]">
      <div class="absolute inset-0 flex items-center justify-center"><span class="h-3 w-3 rotate-45 animate-ping bg-gold/60"></span></div>
      <img id="modalImg" onerror="imgFix(this)" src="" alt="" decoding="async" class="relative h-full w-full object-cover">
    </div>
    <div class="flex flex-col p-8 md:h-[460px] md:overflow-y-auto">
      <p id="modalCat" class="text-[11px] uppercase tracking-[0.35em] text-gold"></p>
      <h3 id="modalName" class="mt-2 font-display text-3xl font-semibold text-ivory"></h3>
      <div class="mt-3 text-[15px] text-gold">★★★★★ <span class="text-sand">0.0 (0)</span></div>
      <p id="modalPrice" class="mt-4 font-display text-3xl text-gold"></p>
      <p id="modalDesc" class="mt-4 text-[15px] leading-relaxed"></p>
      <div class="mt-auto flex gap-3 pt-8"><button id="modalAdd" class="btn-gold px-7 py-3">Add to Cart</button><button id="modalCloseBtn" class="btn-line px-7 py-3">Close</button></div>
    </div>
  </div>
</div>

<button id="backTop" class="fixed bottom-6 right-6 z-[95] flex h-12 w-12 translate-y-20 items-center justify-center rounded-full border border-gold/50 bg-onyx text-gold opacity-0 transition duration-500 hover:bg-gold hover:text-night" aria-label="Back to top">↑</button>
