<!-- ─────────── SHOP : section-wise products ─────────── -->
<section data-page="products" class="page hidden mx-auto max-w-[1500px] px-5 py-20 lg:px-8">
  <p class="eyebrow" data-reveal="up">The complete edit</p>
  <h1 class="draw mt-5 font-display text-5xl font-semibold text-ivory sm:text-6xl" data-reveal="up">Shop All <em class="accent-it">Products</em></h1>

  <!-- quick-jump chips -->
  <div id="catChips" class="mt-10 flex flex-wrap gap-3" data-reveal="up">
    <button class="chip chip-on" data-chip="rings">Rings</button>
    <button class="chip" data-chip="necklace">Necklace</button>
    <button class="chip" data-chip="earrings">Earrings</button>
    <button class="chip" data-chip="bracelet">Bracelets</button>
  </div>

  <!-- filter bar -->
  <div class="panel mt-6 flex flex-wrap items-center gap-4 p-5" data-reveal="up">
    <span class="flex items-center gap-2 font-display text-lg text-ivory"><span class="h-2 w-2 rotate-45 bg-gold"></span>Refine</span>
    <input id="minPrice" type="number" min="0" placeholder="₹ Min" class="field w-28">
    <input id="maxPrice" type="number" min="0" placeholder="₹ Max" class="field w-28">
    <div class="csel relative w-56" id="sortSelect" data-value="featured">
      <button type="button" class="cs-btn field flex items-center justify-between text-left"><span class="cs-label">Featured</span><svg class="cs-chev h-4 w-4 shrink-0 text-gold transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button>
      <div class="cs-menu">
        <button type="button" data-val="featured" class="cs-opt bg-gold/15 text-gold-light">Featured</button>
        <button type="button" data-val="asc" class="cs-opt">Price: Low → High</button>
        <button type="button" data-val="desc" class="cs-opt">Price: High → Low</button>
        <button type="button" data-val="name" class="cs-opt">Name: A–Z</button>
      </div>
    </div>
    <button id="clearFilters" class="btn-line px-6 py-2.5 text-xs">Clear</button>
  </div>

  <!-- grouped sections -->
  <div id="shopSections" class="mt-4"></div>
</section>

