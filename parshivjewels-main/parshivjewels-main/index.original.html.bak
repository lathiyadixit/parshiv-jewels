const u=(id,w=900)=>`https://images.unsplash.com/${id}?q=80&w=${w}&auto=format&fit=crop`;
const PRODUCTS=[
 {id:1,name:'ring 2',price:1222,mrp:1599,category:'rings',badge:'Bestseller',img:u(IMG.ring2),desc:'Heritage-inspired gold ring crowned with a celestial blue topaz and pavé detailing.'},
 {id:2,name:'nackless',price:2000,mrp:2800,category:'necklace',badge:'Bridal',img:u(IMG.neck),desc:'Rose-gold diamond necklace with cascading teardrop brilliance.'},
 {id:3,name:'Ring 1',price:1000,mrp:1400,category:'rings',badge:'New',img:u(IMG.ring1),desc:'Timeless solitaire halo ring crafted in warm rose gold.'},
 {id:4,name:'Jhumka Earrings',price:1500,mrp:1950,category:'earrings',img:u(IMG.ear),desc:'Hand-finished jhumkas with emerald drops and gold beadwork.'},
 {id:5,name:'Tennis Bracelet',price:1800,mrp:2400,category:'bracelet',img:u(IMG.brac),desc:'A dazzling line of brilliant-cut diamonds in flexible gold.'},
 {id:6,name:'Gemstone Trio',price:2400,mrp:3200,category:'rings',badge:'Limited',img:u(IMG.trio),desc:'Bespoke ruby, sapphire and citrine rings on pavé bands.'},
 {id:7,name:'Pearl Studs',price:900,mrp:1200,category:'earrings',img:u(IMG.pearl),desc:'Lustrous freshwater pearls in a minimal gold setting.'},
 {id:8,name:'Bridal Box Set',price:4500,mrp:6000,category:'necklace',badge:'Premium',img:u(IMG.box),desc:'Complete bridal set in a signature Parshiv keepsake box.'},
];
const CATS=[['rings','Rings'],['necklace','Necklace'],['earrings','Earrings'],['bracelet','Bracelets']];
const inr=n=>'₹'+n.toLocaleString('en-IN',{maximumFractionDigits:2});

let tT;function toast(m){const t=$('#toast');$('#toastMsg').textContent=m;t.classList.add('show');clearTimeout(tT);tT=setTimeout(()=>t.classList.remove('show'),2600);}

/* preloader */
let pageLoaded=false,pct=0;
const bar=$('#loadBar'),pctEl=$('#loadPct'),pre=$('#preloader');
const tick=setInterval(()=>{
  pct = pageLoaded ? Math.min(100,pct+8) : Math.min(90,pct+Math.random()*7);
  bar.style.width=pct+'%'; pctEl.textContent=Math.floor(pct)+'%';
  if(pct>=100){clearInterval(tick);pre.classList.add('opacity-0','pointer-events-none');document.body.classList.remove('overflow-hidden');document.body.classList.add('loaded');setTimeout(()=>pre.remove(),700);}
},70);
addEventListener('load',()=>{pageLoaded=true;});
setTimeout(()=>{pageLoaded=true;},3500);

/* images */
function refreshImgs(){$$('img').forEach(im=>{if(im.complete&&im.naturalWidth)im.classList.add('img-in');});}
document.addEventListener('load',e=>{if(e.target.tagName==='IMG')e.target.classList.add('img-in');},true);

/* reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('revealed');io.unobserve(e.target);}}),{threshold:.12});
function observe(){$$('[data-reveal]:not(.revealed)').forEach(el=>io.observe(el));}

/* counters */
const cio=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;cio.unobserve(e.target);const el=e.target,end=+el.dataset.count,t0=performance.now();const step=t=>{const p=Math.min((t-t0)/1600,1);el.textContent=Math.floor(end*(1-Math.pow(1-p,3))).toLocaleString('en-IN');if(p<1)requestAnimationFrame(step);};requestAnimationFrame(step);}),{threshold:.6});
$$('.counter').forEach(el=>cio.observe(el));

/* chrome */
addEventListener('scroll',()=>{
  $('#navbar').classList.toggle('shadow-soft',scrollY>40);
  const h=document.documentElement.scrollHeight-innerHeight;
  $('#progress').style.width=(h>0?(scrollY/h)*100:0)+'%';
  const on=scrollY>600,b=$('#backTop');b.classList.toggle('opacity-0',!on);b.classList.toggle('translate-y-20',!on);
},{passive:true});
$('#backTop').addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));

/* custom dropdown */
function closeAllCsel(except){$$('.csel').forEach(c=>{if(c!==except)c.classList.remove('open');});}
function setCselValue(id,val){const el=$('#'+id);const opt=$(`.cs-opt[data-val="${val}"]`,el);if(!opt)return;
  $$('.cs-opt',el).forEach(x=>x.classList.remove('bg-gold/15','text-gold-light'));
  opt.classList.add('bg-gold/15','text-gold-light');
  $('.cs-label',el).textContent=opt.textContent.trim();
  el.dataset.value=val;}
function initCsel(id,cb){const el=$('#'+id);
  $('.cs-btn',el).addEventListener('click',e=>{e.stopPropagation();closeAllCsel(el);el.classList.toggle('open');});
  $$('.cs-opt',el).forEach(o=>o.addEventListener('click',e=>{e.stopPropagation();setCselValue(id,o.dataset.val);el.classList.remove('open');cb(o.dataset.val);}));}
document.addEventListener('click',()=>closeAllCsel());

/* product card */
function card(p,i=0){return `
<article style="transition-delay:${(i%3)*90}ms" class="tilt group panel flex h-full flex-col overflow-hidden rounded-xl transition duration-500 hover:-translate-y-1 hover:border-gold/50 hover:shadow-glow" data-reveal="up">
  <div class="relative h-72 shrink-0 overflow-hidden bg-night sm:h-80">
    <img src="${p.img}" onerror="imgFix(this)" alt="${p.name} – Parshiv Jewels" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-[1.4s] group-hover:scale-110">
    ${p.badge?`<span class="absolute left-4 top-4 rounded-full bg-gold px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-night shadow-glow">${p.badge}</span>`:''}
    <span class="absolute right-4 top-4 rounded-full border border-gold/40 bg-night/70 px-2.5 py-1 text-[11px] font-medium text-gold-light backdrop-blur">${Math.round((1-p.price/p.mrp)*100)}% OFF</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-[11px] uppercase tracking-[0.3em] text-gold">${p.category}</p>
    <h3 class="mt-1.5 font-display text-2xl leading-snug text-ivory">${p.name}</h3>
    <div class="mt-2 flex items-baseline gap-3"><p class="text-xl font-semibold text-gold">${inr(p.price)}</p><p class="text-sm text-sand/60 line-through">${inr(p.mrp)}</p></div>
    <div class="mt-auto flex gap-2.5 pt-4">
      <button data-view="${p.id}" class="btn-line flex-1 py-2.5 text-xs">View Details</button>
      <button data-add="${p.id}" class="btn-gold flex-1 py-2.5 text-xs">Add to Cart</button>
    </div>
  </div>
</article>`;}
$('#featuredGrid').innerHTML=PRODUCTS.slice(0,3).map((p,i)=>card(p,i)).join('');

/* shop — section-wise */
const state={min:null,max:null,sort:'featured'};
function applyShop(){
  let l=PRODUCTS.filter(p=>(state.min==null||p.price>=state.min)&&(state.max==null||p.price<=state.max));
  if(state.sort==='asc')l.sort((a,b)=>a.price-b.price);
  if(state.sort==='desc')l.sort((a,b)=>b.price-a.price);
  if(state.sort==='name')l.sort((a,b)=>a.name.localeCompare(b.name));
  $('#shopSections').innerHTML=CATS.map(([key,label])=>{
    const items=l.filter(p=>p.category===key);
    if(!items.length)return '';
    return `
    <div id="cat-${key}" class="mt-16 scroll-mt-44 first:mt-8">
      <div class="flex items-center gap-5" data-reveal="up">
        <h2 class="font-display text-3xl font-semibold text-ivory">${label}</h2>
        <span class="h-px flex-1 bg-gradient-to-r from-gold/40 to-transparent"></span>
        <span class="text-xs uppercase tracking-[0.3em] text-sand">${items.length} Pieces</span>
      </div>
      <div class="mt-8 grid gap-7 sm:grid-cols-2 xl:grid-cols-3">${items.map((p,i)=>card(p,i)).join('')}</div>
    </div>`;
  }).join('')||'<p class="mt-16 py-16 text-center text-[15px]">No products match your filters.</p>';
  observe();refreshImgs();
}
initCsel('sortSelect',v=>{state.sort=v;applyShop();});
$('#minPrice').addEventListener('input',e=>{state.min=e.target.value===''?null:+e.target.value;applyShop();});
$('#maxPrice').addEventListener('input',e=>{state.max=e.target.value===''?null:+e.target.value;applyShop();});
$('#clearFilters').addEventListener('click',()=>{Object.assign(state,{min:null,max:null,sort:'featured'});
 setCselValue('sortSelect','featured');$('#minPrice').value='';$('#maxPrice').value='';applyShop();toast('Filters cleared');});

/* category jump chips + deep links */
function scrollToCat(c){if(c==='all'){scrollTo({top:0,behavior:'smooth'});return;}const el=$('#cat-'+c);if(el)el.scrollIntoView({behavior:'smooth',block:'start'});}
$$('#catChips [data-chip]').forEach(b=>b.addEventListener('click',()=>{
  $$('#catChips .chip').forEach(x=>x.classList.remove('chip-on'));b.classList.add('chip-on');scrollToCat(b.dataset.chip);}));
let pendingScroll=null;
$$('[data-goto-cat]').forEach(el=>el.addEventListener('click',()=>{
  const c=el.dataset.gotoCat;
  if(parseHash()==='products'){setTimeout(()=>scrollToCat(c),50);}else{pendingScroll=c;}
}));

/* cart */
const cart=new Map();
const sub=()=>[...cart].reduce((s,[id,q])=>s+PRODUCTS.find(p=>p.id===id).price*q,0);
const tax=()=>sub()*0.18, tot=()=>sub()+tax();
function openCart(){$('#cartDrawer').classList.remove('translate-x-full');$('#cartOverlay').classList.remove('opacity-0','pointer-events-none');document.body.classList.add('overflow-hidden');}
function closeCart(){$('#cartDrawer').classList.add('translate-x-full');$('#cartOverlay').classList.add('opacity-0','pointer-events-none');document.body.classList.remove('overflow-hidden');}
$('#cartBtn').addEventListener('click',openCart);
$('#cartClose').addEventListener('click',closeCart);
$('#cartOverlay').addEventListener('click',closeCart);
function renderCart(){
 const items=[...cart.entries()],count=items.reduce((s,[,q])=>s+q,0);
 const b=$('#cartCount');b.textContent=count;b.classList.toggle('hidden',!count);b.classList.add('flex');b.classList.remove('pop');void b.offsetWidth;b.classList.add('pop');
 $('#cartHeaderCount').textContent=`(${count})`;
 if(!items.length){$('#cartItems').innerHTML='<div class="flex h-full flex-col items-center justify-center gap-4 text-center"><span class="text-5xl text-gold/40">◆</span><p class="font-display text-2xl text-ivory">Your cart is empty</p><p class="text-sm">Discover pieces crafted for forever.</p></div>';$('#cartFooter').classList.add('hidden');return;}
 $('#cartFooter').classList.remove('hidden');
 $('#cartItems').innerHTML=items.map(([id,q])=>{const p=PRODUCTS.find(x=>x.id===id);return `
  <div class="mb-4 flex gap-4 rounded-xl border border-white/5 bg-card p-3">
    <img src="${p.img}" onerror="imgFix(this)" alt="${p.name}" decoding="async" class="h-20 w-16 rounded-lg bg-night object-cover">
    <div class="flex-1"><p class="font-display text-lg leading-tight text-ivory">${p.name}</p><p class="text-sm text-gold">${inr(p.price)}</p>
      <div class="mt-2 flex items-center gap-3"><button data-dec="${id}" class="h-7 w-7 rounded-full border border-white/15 text-ivory hover:border-gold hover:text-gold">−</button><span class="text-[15px] text-ivory">${q}</span><button data-inc="${id}" class="h-7 w-7 rounded-full border border-white/15 text-ivory hover:border-gold hover:text-gold">+</button></div></div>
    <div class="flex flex-col items-end justify-between"><button data-rm="${id}" class="text-sand hover:text-red-400" aria-label="Remove">✕</button><p class="text-[15px] font-medium text-ivory">${inr(p.price*q)}</p></div>
  </div>`;}).join('');
 $('#sumSub').textContent=inr(sub());$('#sumTax').textContent=inr(tax());$('#sumTotal').textContent=inr(tot());refreshImgs();
}
$('#cartItems').addEventListener('click',e=>{
 const inc=e.target.closest('[data-inc]'),dec=e.target.closest('[data-dec]'),rm=e.target.closest('[data-rm]');
 if(inc)cart.set(+inc.dataset.inc,cart.get(+inc.dataset.inc)+1);
 if(dec){const id=+dec.dataset.dec,q=cart.get(id)-1;q<=0?cart.delete(id):cart.set(id,q);}
 if(rm)cart.delete(+rm.dataset.rm);
 if(inc||dec||rm)renderCart();
});
function addToCart(id){cart.set(id,(cart.get(id)||0)+1);renderCart();toast('✓ '+PRODUCTS.find(p=>p.id===id).name+' added to cart');openCart();}
$('#waOrderBtn').addEventListener('click',()=>{
 if(!cart.size)return toast('Your cart is empty');
 const L=[`✨ *PARSHIV JEWELS* ✨`,`━━━━━━━━━━━━━━━━━━`,
  `🧾 *ORDER BILL*  #PJ${String(Date.now()).slice(-6)}`,
  `📅 ${new Date().toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short'})}`,`━━━━━━━━━━━━━━━━━━`];
 let i=1;cart.forEach((q,id)=>{const p=PRODUCTS.find(x=>x.id===id);L.push(`*${i++}. ${p.name}*`,`   Qty ${q} × ${inr(p.price)} = ${inr(p.price*q)}`);});
 L.push(`━━━━━━━━━━━━━━━━━━`,`Subtotal : ${inr(sub())}`,`Shipping : FREE ✅`,`Tax (18%) : ${inr(tax())}`,`*TOTAL : ${inr(tot())}*`,`━━━━━━━━━━━━━━━━━━`,`🛡️ 100% Secure Checkout • Insured Shipping`,`📍 Mahidharpura, Surat, Gujarat`,`🙏 Thank you for choosing Parshiv Jewels!`);
 open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(L.join('\n'))}`,'_blank');
 toast('Opening WhatsApp with your order bill…');
});
$('#continueShopping').addEventListener('click',()=>{closeCart();location.hash='#/products';});

/* quick view */
let currentId=null;
function setModalImg(src){const im=$('#modalImg');
  im.classList.remove('img-in');
  im.onerror=function(){this.onerror=null;this.src=FALL;};
  im.src=src;
  if(im.complete&&im.naturalWidth)requestAnimationFrame(()=>im.classList.add('img-in'));}
function openModal(id){const p=PRODUCTS.find(x=>x.id===id);currentId=id;
 setModalImg(p.img);
 $('#modalCat').textContent=p.category;$('#modalName').textContent=p.name;$('#modalPrice').textContent=inr(p.price);$('#modalDesc').textContent=p.desc;
 const m=$('#modal');m.classList.remove('hidden');m.classList.add('flex');document.body.classList.add('overflow-hidden');}
function closeModal(){$('#modal').classList.add('hidden');$('#modal').classList.remove('flex');document.body.classList.remove('overflow-hidden');}
$('#modalCloseBtn').addEventListener('click',closeModal);$$('[data-close]').forEach(el=>el.addEventListener('click',closeModal));
$('#modalAdd').addEventListener('click',()=>{closeModal();addToCart(currentId);});
addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeCart();}});
document.addEventListener('click',e=>{const a=e.target.closest('[data-add]'),v=e.target.closest('[data-view]');if(a)addToCart(+a.dataset.add);if(v)openModal(+v.dataset.view);});

/* contact → whatsapp */
$('#contactForm').addEventListener('submit',e=>{e.preventDefault();
 const m=[`📩 *NEW ENQUIRY — PARSHIV JEWELS*`,`━━━━━━━━━━━━━━━━━━`,`👤 *Name:* ${$('#cfName').value}`,`📧 *Email:* ${$('#cfEmail').value}`,`📞 *Phone:* ${$('#cfPhone').value||'—'}`,`📌 *Subject:* ${$('#cfSubject').value}`,`📝 *Message:* ${$('#cfMsg').value}`,`━━━━━━━━━━━━━━━━━━`,`Sent from parshivjewels.in`].join('\n');
 open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(m)}`,'_blank');toast('✓ Opening WhatsApp…');e.target.reset();});

/* faq */
$$('.faq-item').forEach(it=>$('.faq-q',it).addEventListener('click',()=>{const o=it.classList.contains('open');$$('.faq-item.open').forEach(x=>x.classList.remove('open'));if(!o)it.classList.add('open');}));

/* tilt */
if(matchMedia('(pointer:fine)').matches){document.addEventListener('mousemove',e=>{const t=e.target.closest('.tilt');if(!t)return;const r=t.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;t.style.transform=`perspective(900px) rotateY(${x*5}deg) rotateX(${-y*5}deg)`;},{passive:true});document.addEventListener('mouseover',e=>{if(!e.target.closest('.tilt'))$$('.tilt').forEach(t=>t.style.transform='');});}

$('#mobileMenuBtn').addEventListener('click',()=>$('#mobileMenu').classList.toggle('hidden'));

/* router */
const routes=['home','products','gallery','contact','faqs'];
function parseHash(){const h=location.hash.replace(/^#\/?/,'');return routes.includes(h)?h:'home';}
function navigate(){const r=parseHash();
 $$('.page').forEach(p=>p.classList.toggle('hidden',p.dataset.page!==r));
 $$('[data-nav]').forEach(a=>a.classList.toggle('active',a.dataset.nav===r));
 const pg=$(`.page[data-page="${r}"]`);pg.classList.remove('page-anim');void pg.offsetWidth;pg.classList.add('page-anim');
 $('#mobileMenu').classList.add('hidden');scrollTo({top:0,behavior:'instant'});observe();refreshImgs();
 if(pendingScroll){setTimeout(()=>scrollToCat(pendingScroll),80);pendingScroll=null;}
}
addEventListener('hashchange',navigate);

navigate();applyShop();renderCart();observe();refreshImgs();
</script>
</body>
</html>