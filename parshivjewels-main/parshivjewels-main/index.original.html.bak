<!-- ═══ 3. STYLES ═══ -->
<style type="text/tailwindcss">
  ::selection{@apply bg-gold text-night}
  html{scroll-behavior:smooth;color-scheme:dark;font-size:17px}
  body{overflow-x:hidden}
  ::-webkit-scrollbar{width:9px}::-webkit-scrollbar-track{background:#0a0806}
  ::-webkit-scrollbar-thumb{background:linear-gradient(#f1dc9f,#8f6c25);border-radius:99px}

  img{opacity:0;transition:opacity .6s ease}
  img.img-in{opacity:1}

  .eyebrow{@apply flex items-center gap-3 font-body text-xs font-medium uppercase tracking-[0.42em] text-gold}
  .eyebrow::before,.eyebrow::after{content:'';@apply h-px w-10 bg-gold/50}
  .accent-it{@apply font-accent italic font-semibold text-gold}

  .btn-gold{@apply relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full bg-gradient-to-r from-gold-deep via-gold to-gold-light font-body text-sm font-semibold uppercase tracking-[0.2em] text-night transition duration-300 hover:scale-[1.04] hover:shadow-glow active:scale-95}
  .btn-gold::after{content:'';@apply absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/50 to-transparent transition duration-700}
  .btn-gold:hover::after{@apply translate-x-full}
  .btn-line{@apply inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-gold/40 font-body text-sm uppercase tracking-[0.2em] text-gold-light transition duration-300 hover:border-gold hover:bg-gold/10 hover:shadow-glow}

  .field{@apply w-full rounded-full border border-white/10 bg-night/70 px-5 py-3 text-[15px] text-ivory placeholder-sand/50 outline-none transition focus:border-gold/70 focus:ring-1 focus:ring-gold/40}
  textarea.field{@apply rounded-[1.75rem]}
  .panel{@apply rounded-2xl border border-white/5 bg-card}

  .nav-link{@apply relative py-2 font-body text-[13px] font-medium uppercase tracking-[0.26em] text-ivory/80 transition hover:text-gold-light}
  .nav-link::after{content:'';@apply absolute bottom-0 left-1/2 h-px w-0 -translate-x-1/2 bg-gold transition-all duration-300}
  .nav-link:hover::after,.nav-link.active::after{@apply w-full}
  .nav-link.active{@apply text-gold}

  .chip{@apply rounded-full border border-white/15 px-5 py-2 font-body text-[12px] uppercase tracking-[0.22em] text-sand transition duration-300 hover:border-gold hover:text-gold-light}
  .chip.chip-on{@apply border-gold bg-gold/10 text-gold-light}

  .csel .cs-menu{@apply absolute left-0 right-0 z-40 mt-2 hidden origin-top overflow-hidden rounded-2xl border border-gold/25 bg-onyx/95 shadow-lift backdrop-blur-xl}
  .csel.open .cs-menu{@apply block}
  @keyframes menuIn{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}
  .csel.open .cs-menu{animation:menuIn .22s ease both}
  .csel.open .cs-chev{@apply rotate-180}
  .cs-opt{@apply block w-full px-5 py-3 text-left text-[15px] text-ivory/80 transition hover:bg-gold/10 hover:text-gold-light}

  .shimmer{background:linear-gradient(110deg,#8f6c25 20%,#fdf3cf 40%,#d2a84f 55%,#8f6c25 80%);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmer 5s linear infinite}
  @keyframes shimmer{to{background-position:200% center}}
  @keyframes marquee{to{transform:translateX(-50%)}}
  .marquee-track{display:flex;width:max-content;animation:marquee var(--sp,28s) linear infinite}
  .marquee:hover .marquee-track{animation-play-state:paused}
  @keyframes kb{0%,100%{transform:scale(1)}50%{transform:scale(1.08) translateY(-8px)}}
  .kenburns img{animation:kb 16s ease-in-out infinite}
  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  .floaty{animation:floaty 5s ease-in-out infinite}
  @keyframes sparkle{0%,100%{opacity:0;transform:scale(.3) rotate(0)}50%{opacity:.9;transform:scale(1) rotate(90deg)}}
  .sparkle{position:absolute;width:7px;height:7px;background:#f1dc9f;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:sparkle 3.2s ease-in-out infinite}
  @keyframes pageIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  .page-anim{animation:pageIn .5s cubic-bezier(.22,1,.36,1) both}
  @keyframes dropLine{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
  .scroll-line span{animation:dropLine 2.2s cubic-bezier(.65,0,.35,1) infinite}

  .shine{position:relative;overflow:hidden}
  .shine::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(241,220,159,.14) 50%,transparent 60%);transform:translateX(-130%);transition:transform 1s ease;pointer-events:none}
  .shine:hover::after{transform:translateX(130%)}
  .tilt{position:relative}
  .frame::before{content:'';@apply pointer-events-none absolute inset-3 border border-gold/0 transition duration-500}
  .frame:hover::before{@apply border-gold/60}

  .draw,.draw-c{position:relative}
  .draw::after,.draw-c::after{content:'';position:absolute;bottom:-10px;left:0;height:1px;width:100%;background:linear-gradient(90deg,#8f6c25,#f1dc9f);transform:scaleX(0);transform-origin:left;transition:transform 1.1s ease .25s}
  .draw-c::after{background:linear-gradient(90deg,transparent,#d2a84f,transparent);transform-origin:center}
  [data-reveal].revealed .draw::after,[data-reveal].revealed .draw-c::after,[data-reveal].revealed.draw::after,[data-reveal].revealed.draw-c::after{transform:scaleX(1)}

  .f-link{@apply relative transition duration-300}
  .f-link::before{content:'◆';@apply absolute left-0 top-1/2 -translate-y-1/2 text-[9px] text-gold opacity-0 transition duration-300}
  .f-link:hover{@apply pl-4 text-gold-light}
  .f-link:hover::before{@apply opacity-100}

  [data-reveal]{opacity:0;transition:opacity .7s ease,transform .7s cubic-bezier(.22,1,.36,1)}
  [data-reveal="up"]{transform:translateY(40px)}[data-reveal="left"]{transform:translateX(-46px)}
  [data-reveal="right"]{transform:translateX(46px)}[data-reveal="zoom"]{transform:scale(.92)}
  [data-reveal].revealed{opacity:1;transform:none}
  .mask-line{overflow:hidden}
  .mask-line>span{display:block;transform:translateY(115%);transition:transform 1.1s cubic-bezier(.22,1,.36,1)}
  body.loaded .mask-line>span{transform:none}

  .faq-item .acc-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s ease}
  .faq-item.open .acc-body{grid-template-rows:1fr}
  .faq-item.open{@apply border-gold/40}
  .faq-item.open .faq-v{transform:rotate(0)}
  .faq-item.open .faq-q{@apply text-gold-light}

  #toast{@apply pointer-events-none fixed bottom-8 left-1/2 z-[120] -translate-x-1/2 translate-y-5 rounded-full border border-gold/50 bg-onyx/95 px-7 py-3 text-[15px] tracking-wide text-gold-light opacity-0 shadow-glow backdrop-blur transition-all duration-300}
  #toast.show{@apply translate-y-0 opacity-100}
  @keyframes pop{0%{transform:scale(.4)}60%{transform:scale(1.25)}100%{transform:scale(1)}}
  .pop{animation:pop .4s ease}
  .social{@apply flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 text-sand transition duration-300 hover:-translate-y-1 hover:border-gold hover:text-gold hover:shadow-glow}
</style>
</head>

<body class="overflow-hidden bg-night font-body text-sand antialiased">

<!-- ═══ 4. LAYOUT ═══ -->
<div id="preloader" class="fixed inset-0 z-[200] flex flex-col items-center justify-center gap-6 bg-night">
  <div class="relative font-display text-6xl tracking-[0.2em] text-gold">PJ<span class="absolute -right-3 -top-1 h-2 w-2 rotate-45 bg-gold-light animate-ping"></span></div>
  <p class="text-[11px] uppercase tracking-[0.6em] text-sand">Parshiv Jewels</p>
  <div class="h-[2px] w-60 overflow-hidden rounded-full bg-white/10"><div id="loadBar" class="h-full w-0 bg-gradient-to-r from-gold-deep via-gold to-gold-light transition-all duration-150"></div></div>
  <p id="loadPct" class="text-[11px] tracking-[0.4em] text-gold-light">0%</p>
</div>

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded-full focus:bg-gold focus:px-5 focus:py-2 focus:text-night">Skip to content</a>
